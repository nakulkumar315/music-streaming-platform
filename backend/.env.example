# Runtime
NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost:8000
# Development may use *. Production must list explicit HTTPS origins and cannot use *.
CORS_ALLOWED_ORIGINS=*
# Number of trusted reverse-proxy hops. Production must set this explicitly.
TRUST_PROXY_HOPS=0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/music_platform
# Optional read replica; primary is used when omitted.
DATABASE_URL_REPLICA=

# Auth / sensitive signing
# Generate independent long random values per environment. Never reuse production values in test/dev.
JWT_SECRET=replace-with-a-long-random-secret
SIGNATURE_ENCRYPTION_KEY=replace-with-64-hex-characters-or-another-long-random-secret

# Optional Redis cache. Leave empty or use disabled to run without cache.
REDIS_URL=disabled

# Optional monitoring
SENTRY_DSN=
SENTRY_RELEASE=

# Storage provider: local | firebase | s3 | cloudinary
# local is development/test only.
STORAGE_PROVIDER=cloudinary

# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_WEBHOOK_URL=https://your-domain.example/api/v1/media/webhook
CLOUDINARY_WEBHOOK_MAX_AGE_SECONDS=7200

# Local storage
LOCAL_STORAGE_ROOT=./storage
LOCAL_PRIVATE_STREAM_ROUTE=/media/stream

# Firebase (required when STORAGE_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# AWS S3 (required when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_SIGNED_URL_EXPIRES_IN=300

# Media access / security
MEDIA_SIGNED_TOKEN_SECRET=replace-with-a-separate-long-random-secret
MEDIA_URL_TTL_SECONDS=300

# Upload limits (MB)
MAX_UPLOAD_AUDIO_MB=50
MAX_UPLOAD_VIDEO_MB=500
MAX_UPLOAD_IMAGE_MB=10

# Razorpay / subscriptions
# When SUBSCRIPTION_ENABLED=true all three Razorpay values are required at startup.
# Use separate test/live credentials per environment; never commit real credentials.
SUBSCRIPTION_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
