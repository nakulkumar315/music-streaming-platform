# Public values embedded in the mobile application bundle.
# Do not place private/server secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_ARTIST_WEB_URL=https://artists.example.com

# Optional checkout public key. The canonical payment order response also returns
# the public Razorpay key id from the backend configuration.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me

# Optional runtime monitoring values embedded in the application bundle.
# A Sentry DSN contains a public project key and may be exposed to the client.
# Set EXPO_PUBLIC_SENTRY_RELEASE to the same release identifier used by the
# symbol/source-map upload process for production builds.
EXPO_PUBLIC_SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
EXPO_PUBLIC_SENTRY_RELEASE=fan-app@1.0.0

# Build-time Sentry upload credentials are intentionally NOT EXPO_PUBLIC values
# and must be configured as protected EAS/CI secrets instead of committed here:
#   SENTRY_AUTH_TOKEN
#   SENTRY_ORG
#   SENTRY_PROJECT
